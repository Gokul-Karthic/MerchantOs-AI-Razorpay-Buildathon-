# MerchantOS AI v1.4.1 is hard-locked to Razorpay Test Mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Stable privacy-preserving joins for browser/IP/customer test context.
MERCHANTOS_HASH_SALT=change-me-to-a-long-random-local-secret

# Provider actions are OFF by default. When true, MerchantOS may create a
# Razorpay TEST MODE Payment Link only when guardrails allow it.
MERCHANTOS_TEST_ACTIONS_ENABLED=false
MERCHANTOS_MAX_AUTO_TEST_ACTION_INR=1000
MERCHANTOS_MAX_APPROVAL_TEST_ACTION_INR=10000

DATABASE_URL=sqlite:///./merchantos.db
# RiskNet v2 locks the first finalized Test-Mode artifact. Leave refit disabled in normal operation.
MERCHANTOS_ALLOW_MODEL_REFIT=false

# RiskNet policy thresholds are read from the locked model artifact.
# The validated review threshold (currently 0.64) routes events to review.
# 0.85 remains a separate critical-risk reporting tier; no refit is required.

# Docker / distributed dashboard configuration. These defaults are normally
# supplied by docker-compose.yml and do not need to be changed for local runs.
# MERCHANTOS_DB_PATH=/data/merchantos.db
# MERCHANTOS_ARTIFACT_DIR=/data/artifacts
# MERCHANTOS_API_BASE_URL=http://api:8000/api
# MERCHANTOS_PUBLIC_API_URL=http://localhost:8000
MERCHANTOS_DASHBOARD_PUBLIC_URL=http://localhost:8501
